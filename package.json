{
  "name": "@unabandoned/readable-stream",
  "version": "4.8.0",
  "description": "Node.js Streams, a user-land copy of the stream library from Node.js",
  "homepage": "https://github.com/unabandoned/readable-stream#readme",
  "license": "MIT",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://choosealicense.com/licenses/mit/"
    }
  ],
  "keywords": [
    "readable",
    "stream",
    "pipe"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unabandoned/readable-stream.git"
  },
  "bugs": {
    "url": "https://github.com/unabandoned/readable-stream/issues"
  },
  "main": "lib/ours/index.js",
  "files": [
    "lib",
    "LICENSE",
    "README.md"
  ],
  "browser": {
    "util": "./lib/ours/util.js",
    "./lib/ours/index.js": "./lib/ours/browser.js"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "tap --rcfile=./tap.yml test/parallel/test-*.js test/ours/test-*.js",
    "coverage": "c8 -c ./c8.json tap --rcfile=./tap.yml test/parallel/test-*.js test/ours/test-*.js"
  },
  "dependencies": {
    "buffer": "npm:@unabandoned/buffer@^6",
    "events": "npm:@unabandoned/events@^3",
    "process": "^0.11.10"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@sinonjs/fake-timers": "15.4.0",
    "c8": "12.0.0",
    "tap": "16.3.10"
  },
  "engines": {
    "node": ">=22.12"
  }
}
